{
  "name": "css-cause-map",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Find the CSS rules and parent elements causing a layout problem.",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "prepare:wxt": "wxt prepare",
    "build:extension": "wxt build",
    "package": "wxt zip",
    "build:site": "vite build --config vite.site.config.ts && node scripts/stage-package.mjs",
    "build": "npm run build:extension && npm run package && npm run build:site",
    "pretest": "npm run prepare:wxt",
    "test": "vitest run && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:claims": "playwright test tests/claims.spec.ts --project=desktop",
    "test:watch": "vitest",
    "pretypecheck": "npm run prepare:wxt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/chrome": "^0.0.324",
    "@playwright/test": "1.58.2",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.36.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.58.2"
    }
  }
}
